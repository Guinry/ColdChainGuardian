<view class="page-container">
  <view class="fixed-nav" style="height: {{navHeight}}px;"></view>

  <scroll-view class="scroll-area"
               scroll-y="true"
               type="list"
               refresher-enabled="true"
               refresher-triggered="{{isRefreshing}}"
               bindrefresherrefresh="onRefresh"
               refresher-background="#1565D8"
               refresher-default-style="white">

    <view class="header-bg">
      <view class="header-content">
        <view class="user-profile">
          <view class="text-avatar">{{userInfo.avatarText}}</view>
          <view class="user-info">
            <text class="greeting">{{userInfo.name}}</text>
            <text class="shift-tag">{{userInfo.roleText}} · {{lastUpdated}} 更新</text>
          </view>
        </view>
      </view>

      <view class="summary-strip">
        <view class="summary-item">
          <text class="summary-value">{{summary.pendingTasks}}</text>
          <text class="summary-label">待接收</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{summary.urgentAlerts}}</text>
          <text class="summary-label">紧急告警</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{summary.onlineDevices}}/{{summary.totalDevices}}</text>
          <text class="summary-label">在线设备</text>
        </view>
      </view>
    </view>

    <view class="quick-grid">
      <view class="quick-action" bindtap="scanQRCode" hover-class="pressing">
        <view class="quick-icon scan">扫</view>
        <view class="quick-copy">
          <text class="quick-title">设备扫码</text>
          <text class="quick-desc">现场核验设备</text>
        </view>
      </view>
      <view class="quick-action" bindtap="quickReport" hover-class="pressing">
        <view class="quick-icon report">报</view>
        <view class="quick-copy">
          <text class="quick-title">快捷处置</text>
          <text class="quick-desc">进入告警/工单</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">紧急告警</text>
        <text class="section-link" bindtap="goAllAlerts">全部</text>
      </view>

      <view class="alert-list" wx:if="{{urgentAlerts.length > 0}}">
        <view class="alert-row {{item.priority}}" wx:for="{{urgentAlerts}}" wx:key="id" data-id="{{item.id}}" bindtap="goToAlert" hover-class="pressing">
          <view class="alert-main">
            <view class="row-head">
              <text class="row-title">{{item.title}}</text>
              <text class="priority-badge">{{item.priorityText}}</text>
            </view>
            <text class="row-meta">{{item.location}}</text>
          </view>
          <text class="row-time">{{item.time}}</text>
        </view>
      </view>

      <view class="empty-panel" wx:else>
        <text class="empty-title">暂无紧急告警</text>
        <text class="empty-desc">当前没有高危或严重告警需要优先处理</text>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">待接收工单</text>
        <text class="section-link" bindtap="goAllOrders">全部</text>
      </view>

      <view class="order-list" wx:if="{{pendingOrders.length > 0}}">
        <view class="order-row {{item.priority}}" wx:for="{{pendingOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="goToWorkOrder" hover-class="pressing">
          <view class="order-main">
            <view class="row-head">
              <text class="row-title">{{item.title}}</text>
              <text class="type-badge">{{item.type}}</text>
            </view>
            <text class="row-meta">{{item.location}}</text>
            <text class="deadline {{item.isOverdue ? 'overdue' : ''}}">{{item.deadline}}</text>
          </view>
        </view>
      </view>

      <view class="empty-panel" wx:else>
        <text class="empty-title">没有待接收工单</text>
        <text class="empty-desc">新的维修或巡检任务会显示在这里</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
