page {
  height: 100vh;
  background: #F4F7FB;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.fixed-nav {
  flex-shrink: 0;
  background: #1565D8;
}

.scroll-area {
  flex: 1;
  overflow: hidden;
}

.header-bg {
  background: #1565D8;
  padding: 10rpx 32rpx 96rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-profile {
  display: flex;
  align-items: center;
}

.text-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
}

.user-info {
  display: flex;
  flex-direction: column;
}

.greeting {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.shift-tag {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.summary-strip {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.summary-item {
  min-height: 120rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  padding: 22rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.summary-value {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.summary-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  margin-top: 10rpx;
}

.quick-grid {
  margin: -56rpx 32rpx 28rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.quick-action {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 30rpx rgba(21, 101, 216, 0.10);
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  margin-right: 18rpx;
}

.quick-icon.scan {
  background: #1565D8;
}

.quick-icon.report {
  background: #00A870;
}

.quick-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quick-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.quick-desc {
  color: #7B8798;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.section {
  margin: 0 32rpx 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #172033;
}

.section-link {
  color: #1565D8;
  font-size: 26rpx;
  font-weight: 600;
}

.alert-list,
.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.alert-row,
.order-row,
.empty-panel {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 32, 51, 0.04);
}

.alert-row {
  display: flex;
  align-items: flex-start;
  border-left: 8rpx solid #D8E2F0;
}

.alert-row.urgent {
  border-left-color: #E5484D;
}

.alert-row.high {
  border-left-color: #F59E0B;
}

.alert-main,
.order-main {
  flex: 1;
  min-width: 0;
}

.row-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row-title {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.priority-badge,
.type-badge {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.priority-badge {
  background: #FFF1F1;
  color: #E5484D;
}

.type-badge {
  background: #EEF5FF;
  color: #1565D8;
}

.row-meta {
  display: block;
  margin-top: 12rpx;
  color: #637083;
  font-size: 25rpx;
  line-height: 1.45;
}

.row-time {
  color: #8B96A8;
  font-size: 23rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.deadline {
  display: block;
  margin-top: 10rpx;
  color: #637083;
  font-size: 24rpx;
}

.deadline.overdue {
  color: #E5484D;
  font-weight: 700;
}

.order-row {
  border-left: 8rpx solid #D8E2F0;
}

.order-row.urgent {
  border-left-color: #E5484D;
}

.order-row.high {
  border-left-color: #F59E0B;
}

.empty-panel {
  padding: 44rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  color: #8B96A8;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.pressing {
  opacity: 0.78;
  transform: scale(0.99);
}

.bottom-space {
  height: 60rpx;
}
