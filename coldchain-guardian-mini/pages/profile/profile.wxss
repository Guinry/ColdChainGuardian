page {
  height: 100vh;
  background: #F4F7FB;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.fixed-nav {
  background: #1565D8;
  flex-shrink: 0;
  z-index: 20;
}

.nav-title {
  text-align: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 800;
}

.scroll-area {
  flex: 1;
  overflow: hidden;
}

.header-bg {
  height: 110rpx;
  background: #1565D8;
  border-radius: 0 0 36rpx 36rpx;
}

.profile-card {
  margin: -62rpx 32rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 34rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 30rpx rgba(21, 101, 216, 0.10);
}

.avatar-wrap {
  margin-right: 28rpx;
}

.avatar-img,
.avatar-text {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-text {
  background: #1565D8;
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #172033;
  font-size: 38rpx;
  font-weight: 800;
}

.user-meta {
  color: #637083;
  font-size: 25rpx;
  margin-top: 10rpx;
}

.section-title {
  color: #637083;
  font-size: 26rpx;
  font-weight: 700;
  margin: 0 40rpx 16rpx;
}

.performance-grid {
  margin: 0 32rpx 34rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.perf-item {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 32, 51, 0.04);
  display: flex;
  flex-direction: column;
}

.perf-val {
  color: #172033;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.1;
}

.perf-label {
  color: #8B96A8;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.perf-item.warning .perf-val {
  color: #E5484D;
}

.settings-card {
  margin: 0 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 30rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 32, 51, 0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #EEF2F7;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.setting-name {
  color: #172033;
  font-size: 29rpx;
  font-weight: 700;
}

.setting-desc {
  color: #8B96A8;
  font-size: 23rpx;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.status-pill.ok {
  color: #00875A;
  background: #F1F8F5;
}

.status-pill.bad {
  color: #E5484D;
  background: #FFF1F1;
}

.setting-switch {
  transform: scale(0.84);
  transform-origin: right center;
  margin-right: -10rpx;
}

.arrow-item:active {
  opacity: 0.75;
}

.arrow-icon {
  color: #B7C0CD;
  font-size: 44rpx;
  line-height: 1;
}

.text-danger {
  color: #E5484D;
}

.mt-24 {
  margin-top: 6rpx;
}

.bottom-space {
  height: 70rpx;
}
