<view class="page-container">
  <view class="fixed-nav" style="height: {{navHeight}}px;">
    <view class="nav-title"
      style="padding-top: {{paddingTop}}px; height: {{capsuleHeight}}px; line-height: {{capsuleHeight}}px;">
      我的
    </view>
  </view>

  <scroll-view class="scroll-area"
               scroll-y="true"
               type="list"
               refresher-enabled="true"
               refresher-triggered="{{isRefreshing}}"
               bindrefresherrefresh="onRefresh">

    <view class="header-bg"></view>

    <view class="profile-card">
      <view class="avatar-wrap">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-text">{{userInfo.avatarText}}</view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-meta">{{userInfo.roleText}} · {{userInfo.phone}}</text>
      </view>
    </view>

    <view class="section-title">工单概览</view>
    <view class="performance-grid">
      <view class="perf-item">
        <text class="perf-val">{{performance.pendingCount}}</text>
        <text class="perf-label">待接收</text>
      </view>
      <view class="perf-item">
        <text class="perf-val">{{performance.processingCount}}</text>
        <text class="perf-label">处理中</text>
      </view>
      <view class="perf-item warning">
        <text class="perf-val">{{performance.overdueCount}}</text>
        <text class="perf-label">已逾期</text>
      </view>
      <view class="perf-item">
        <text class="perf-val">{{performance.completedThisWeek}}</text>
        <text class="perf-label">本周完成</text>
      </view>
    </view>

    <view class="section-title">连接状态</view>
    <view class="settings-card">
      <view class="setting-item">
        <view class="setting-copy">
          <text class="setting-name">后端服务</text>
          <text class="setting-desc">{{connection.apiBaseUrl}}</text>
        </view>
        <text class="status-pill {{connection.status === '已连接' ? 'ok' : 'bad'}}">{{connection.status}}</text>
      </view>
      <view class="setting-item arrow-item" bindtap="manualSync">
        <view class="setting-copy">
          <text class="setting-name">刷新数据</text>
          <text class="setting-desc">重新拉取账号与工单统计</text>
        </view>
        <text class="arrow-icon">›</text>
      </view>
    </view>

    <view class="section-title">消息偏好</view>
    <view class="settings-card">
      <view class="setting-item" wx:for="{{notificationSettings}}" wx:key="id">
        <view class="setting-copy">
          <text class="setting-name">{{item.name}}</text>
          <text class="setting-desc">{{item.enabled ? '已开启' : '已关闭'}}</text>
        </view>
        <switch class="setting-switch" color="#1565D8" checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="toggleNotification" />
      </view>
    </view>

    <view class="settings-card mt-24">
      <view class="setting-item arrow-item" bindtap="showAbout">
        <text class="setting-name">关于冷链守护</text>
        <text class="arrow-icon">›</text>
      </view>
      <view class="setting-item arrow-item" bindtap="handleLogout">
        <text class="setting-name text-danger">退出登录</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
