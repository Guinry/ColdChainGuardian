<view class="page-container">

  <view class="fixed-header" style="padding-top: {{paddingTop}}px;">
    <view class="nav-title" style="height: {{capsuleHeight}}px; line-height: {{capsuleHeight}}px;">
      <text>工单处理</text>
    </view>
    <view class="segment-wrap">
      <view class="segment-control">
        <view class="segment-item {{activeTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="switchTab">待接收</view>
        <view class="segment-item {{activeTab === 'processing' ? 'active' : ''}}" data-tab="processing" bindtap="switchTab">处理中</view>
        <view class="segment-item {{activeTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="switchTab">已完成</view>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-area" scroll-y="true" type="list" refresher-enabled="true" refresher-triggered="{{isRefreshing}}" bindrefresherrefresh="onRefresh">

    <view class="workorder-list" wx:if="{{workOrders.length > 0}}">
      <view class="workorder-card {{item.priority}}" wx:for="{{workOrders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}" hover-class="card-hover">

        <view class="card-header">
          <view class="title-wrap">
            <view class="type-tag">{{item.type}}</view>
            <text class="workorder-title">{{item.title}}</text>
          </view>
        </view>

        <view class="card-body">
          <view class="info-row">
            <text class="info-icon">📍</text>
            <text class="info-text">{{item.location}}</text>
          </view>
          <view class="info-row mt-10">
            <text class="info-icon">⏳</text>
            <text class="info-text {{item.priority === 'urgent' ? 'text-danger' : ''}}">{{item.deadline}}</text>
          </view>
        </view>

        <view class="card-footer">
          <text class="footer-text">查看详情</text>
          <text class="footer-icon">></text>
        </view>

      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-emoji">📋</text>
      <text class="empty-text">当前分类下没有工单</text>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>
</view>