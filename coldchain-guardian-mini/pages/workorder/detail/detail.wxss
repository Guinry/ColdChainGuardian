page {
  height: 100vh;
  background: #F4F7FB;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.fixed-header {
  flex-shrink: 0;
  background: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(23, 32, 51, 0.05);
  z-index: 20;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.back-btn,
.right-placeholder {
  width: 64rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.back-icon {
  color: #172033;
  font-size: 54rpx;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
}

.scroll-area {
  flex: 1;
  overflow: hidden;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
}

.hero-card,
.info-card,
.operation-card,
.readonly-card,
.log-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 32, 51, 0.04);
}

.hero-card {
  border-left: 8rpx solid #D8E2F0;
}

.hero-card.urgent {
  border-left-color: #E5484D;
}

.hero-card.high {
  border-left-color: #F59E0B;
}

.hero-card.medium {
  border-left-color: #1565D8;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.main-title {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.status-tag {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #EEF5FF;
  color: #1565D8;
}

.status-tag.pending {
  background: #FFF7E6;
  color: #B45309;
}

.status-tag.processing {
  background: #EEF5FF;
  color: #1565D8;
}

.status-tag.verifying {
  background: #F1F8F5;
  color: #00875A;
}

.status-tag.completed,
.status-tag.closed {
  background: #EEF2F7;
  color: #637083;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  background: #F1F4F8;
  color: #637083;
  font-size: 22rpx;
  font-weight: 700;
}

.tag.danger {
  background: #FFF1F1;
  color: #E5484D;
}

.description {
  display: block;
  margin-top: 22rpx;
  color: #4D5A6B;
  font-size: 27rpx;
  line-height: 1.6;
}

.info-card {
  padding: 8rpx 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EEF2F7;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  flex-shrink: 0;
  color: #8B96A8;
  font-size: 25rpx;
}

.value {
  flex: 1;
  color: #172033;
  font-size: 26rpx;
  text-align: right;
  line-height: 1.45;
}

.danger-text {
  color: #E5484D;
  font-weight: 700;
}

.section-title {
  display: block;
  color: #172033;
  font-size: 31rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.checkin-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  color: #1565D8;
  background: #EEF5FF;
  font-size: 29rpx;
  font-weight: 800;
  margin-bottom: 30rpx;
}

.checkin-btn.checked {
  color: #00875A;
  background: #F1F8F5;
}

.checkin-btn::after {
  border: none;
}

.operation-item {
  margin-top: 30rpx;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.item-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.sub-label {
  color: #8B96A8;
  font-size: 23rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.photo-item,
.photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.photo-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E5484D;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  font-size: 26rpx;
}

.photo-add {
  background: #F4F7FB;
  border: 2rpx dashed #D8E2F0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.add-icon {
  color: #1565D8;
  font-size: 44rpx;
  line-height: 1;
}

.add-text {
  color: #637083;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.record-box {
  border: 2rpx solid #E4EAF2;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.record-input {
  width: 100%;
  min-height: 210rpx;
  padding: 22rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  color: #172033;
}

.voice-btn {
  text-align: center;
  color: #1565D8;
  background: #F7FAFD;
  border-top: 1rpx solid #E4EAF2;
  font-size: 25rpx;
  font-weight: 700;
  padding: 20rpx;
}

.readonly-title {
  display: block;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.readonly-desc {
  display: block;
  color: #637083;
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.log-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding-bottom: 26rpx;
}

.log-item:last-child {
  padding-bottom: 0;
}

.log-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #1565D8;
  margin: 8rpx 20rpx 0 0;
  flex-shrink: 0;
}

.log-content {
  flex: 1;
  min-width: 0;
}

.log-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.log-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
}

.log-time {
  color: #8B96A8;
  font-size: 22rpx;
  flex-shrink: 0;
}

.log-meta {
  display: block;
  margin-top: 6rpx;
  color: #637083;
  font-size: 23rpx;
}

.log-remark {
  display: block;
  margin-top: 8rpx;
  color: #4D5A6B;
  font-size: 25rpx;
  line-height: 1.45;
}

.empty-log {
  color: #8B96A8;
  font-size: 25rpx;
  text-align: center;
  padding: 30rpx 0 8rpx;
}

.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8B96A8;
  font-size: 28rpx;
}

.bottom-spacer {
  height: 150rpx;
}

.fixed-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -8rpx 24rpx rgba(23, 32, 51, 0.08);
  z-index: 30;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #1565D8;
  font-size: 31rpx;
  font-weight: 800;
}

.submit-btn::after {
  border: none;
}
