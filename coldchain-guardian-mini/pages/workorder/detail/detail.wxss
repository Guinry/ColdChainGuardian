/* pages/workorder/detail/detail.wxss */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  padding-bottom: 140rpx; /* 为底部固定栏留出空间 */
}

/* 工单信息区 */
.info-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.info-item {
  margin-bottom: 25rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #909399;
  display: block;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.value {
  font-size: 28rpx;
  color: #303133;
  display: block;
}

.multiline {
  line-height: 1.6;
}

/* 操作流区 */
.operation-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.operation-item {
  margin-bottom: 35rpx;
}

.operation-item:last-child {
  margin-bottom: 0;
}

.operation-label {
  font-size: 28rpx;
  color: #303133;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

/* 扫码签到按钮 */
.checkin-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #409EFF, #66b1ff);
  color: white;
  border-radius: 15rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 照片区 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #c0c4cc;
  margin-bottom: 10rpx;
}

.photo-add-text {
  font-size: 24rpx;
  color: #909399;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
}

.photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #F56C6C;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

/* 处理记录输入 */
.record-input-container {
  position: relative;
}

.record-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 15rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #303133;
  box-sizing: border-box;
}

.voice-input-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: #409EFF;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 底部固定栏 */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: white;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #67C23A, #85ce61);
  color: white;
  border-radius: 15rpx;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}