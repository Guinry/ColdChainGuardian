<view class="page-container">
  
  <view class="fixed-header" style="padding-top: {{paddingTop}}px;">
    <view class="nav-title" style="height: {{capsuleHeight}}px; line-height: {{capsuleHeight}}px;">
      <text>告警大厅</text>
    </view>
    <view class="segment-wrap">
      <view class="segment-control">
        <view class="segment-item {{activeTab === 'unhandled' ? 'active' : ''}}" 
              data-tab="unhandled" bindtap="switchTab">
          <text>未处理 ({{unhandledCount}})</text>
        </view>
        <view class="segment-item {{activeTab === 'processing' ? 'active' : ''}}" 
              data-tab="processing" bindtap="switchTab">
          <text>处理中 ({{processingCount}})</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-area" 
               scroll-y="true" 
               type="list"
               refresher-enabled="true"
               refresher-triggered="{{isRefreshing}}"
               bindrefresherrefresh="onRefresh">
    
    <view class="alert-list" wx:if="{{currentAlerts.length > 0}}">
      <view class="alert-card {{item.priority}}" wx:for="{{currentAlerts}}" wx:key="id" hover-class="card-hover">
        <view class="card-header">
          <view class="title-wrap">
            <view class="priority-tag">
              {{item.priority === 'urgent' ? '紧急' : item.priority === 'high' ? '高危' : '提示'}}
            </view>
            <text class="alert-title">{{item.title}}</text>
          </view>
          <text class="alert-time">{{item.time}}</text>
        </view>

        <view class="card-body">
          <view class="data-panel">
            <view class="data-box">
              <text class="data-label">当前数值</text>
              <text class="data-value current-color">{{item.currentValue}}</text>
            </view>
            <view class="data-divider"></view>
            <view class="data-box">
              <text class="data-label">预设阈值</text>
              <text class="data-value limit-color">{{item.thresholdValue}}</text>
            </view>
          </view>
          <view class="location-row">
            <text class="loc-icon">📍</text>
            <text class="loc-text">发生位置：{{item.location}}</text>
          </view>
        </view>

        <view class="card-footer">
          <button class="btn-ghost" data-id="{{item.id}}" catchtap="dismissAlert">误报消除</button>
          <button class="btn-primary" data-id="{{item.id}}" catchtap="transferToOrder">转工单</button>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-emoji">🎉</text>
      <text class="empty-text">太棒了，当前没有{{activeTab === 'unhandled' ? '未处理' : '处理中'}}的告警</text>
    </view>

    <view style="height: 60rpx;"></view>
  </scroll-view>

</view>