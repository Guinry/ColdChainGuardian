page {
  height: 100vh;
  background: #F4F7FB;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
}

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.fixed-header {
  flex-shrink: 0;
  z-index: 20;
  background: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(23, 32, 51, 0.05);
}

.nav-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  color: #172033;
}

.search-bar {
  margin: 20rpx 32rpx 0;
  height: 76rpx;
  border-radius: 18rpx;
  background: #F4F7FB;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 27rpx;
  color: #172033;
}

.search-clear,
.search-action {
  margin-left: 18rpx;
  font-size: 25rpx;
  color: #8B96A8;
}

.search-action {
  color: #1565D8;
  font-weight: 700;
}

.segment-wrap {
  padding: 22rpx 32rpx 20rpx;
}

.segment-control {
  display: flex;
  background: #EEF2F7;
  border-radius: 18rpx;
  padding: 6rpx;
}

.segment-item {
  flex: 1;
  height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #637083;
  font-size: 25rpx;
  font-weight: 600;
}

.segment-item.active {
  background: #FFFFFF;
  color: #1565D8;
  box-shadow: 0 4rpx 14rpx rgba(23, 32, 51, 0.06);
}

.segment-count {
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: rgba(21, 101, 216, 0.10);
  color: inherit;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.scroll-area {
  flex: 1;
  overflow: hidden;
}

.alert-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.alert-card {
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 18rpx rgba(23, 32, 51, 0.04);
  border-left: 8rpx solid #D8E2F0;
}

.alert-card.focused {
  box-shadow: 0 0 0 4rpx rgba(21, 101, 216, 0.12), 0 8rpx 24rpx rgba(21, 101, 216, 0.12);
}

.alert-card.urgent {
  border-left-color: #E5484D;
}

.alert-card.high {
  border-left-color: #F59E0B;
}

.alert-card.medium {
  border-left-color: #1565D8;
}

.card-hover {
  opacity: 0.82;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.priority-tag {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
  font-size: 21rpx;
  color: #E5484D;
  background: #FFF1F1;
  font-weight: 800;
}

.alert-card.high .priority-tag {
  color: #B45309;
  background: #FFF7E6;
}

.alert-card.medium .priority-tag {
  color: #1565D8;
  background: #EEF5FF;
}

.alert-title {
  min-width: 0;
  flex: 1;
  color: #172033;
  font-size: 31rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.alert-time {
  flex-shrink: 0;
  color: #8B96A8;
  font-size: 23rpx;
  margin-top: 5rpx;
}

.data-panel {
  margin-top: 24rpx;
  background: #F7FAFD;
  border-radius: 18rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
}

.data-box {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.data-label {
  color: #8B96A8;
  font-size: 23rpx;
}

.data-value {
  color: #172033;
  font-size: 38rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.current-color {
  color: #E5484D;
}

.alert-card.high .current-color {
  color: #F59E0B;
}

.alert-card.medium .current-color {
  color: #1565D8;
}

.limit-color {
  color: #172033;
}

.data-divider {
  width: 2rpx;
  height: 60rpx;
  background: #E4EAF2;
  margin: 0 28rpx;
}

.meta-block {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-line {
  color: #637083;
  font-size: 25rpx;
  line-height: 1.45;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #EEF2F7;
}

.btn-ghost,
.btn-primary {
  margin: 0;
  min-width: 150rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.btn-ghost::after,
.btn-primary::after {
  border: none;
}

.btn-ghost {
  color: #637083;
  background: #F1F4F8;
}

.btn-primary {
  color: #FFFFFF;
  background: #1565D8;
}

.readonly-tip {
  color: #8B96A8;
  font-size: 25rpx;
}

.load-more {
  text-align: center;
  color: #1565D8;
  font-size: 26rpx;
  padding: 24rpx 0 6rpx;
}

.load-more.done {
  color: #8B96A8;
}

.empty-state {
  padding: 220rpx 48rpx 0;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #172033;
  font-weight: 800;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8B96A8;
}

.bottom-space {
  height: 70rpx;
}
