/**app.wxss**/

/* 全局样式定义 - 遵循冷链守护设计系统 */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* 色彩系统 */
.text-red { color: #F56C6C; }      /* 紧急告警、逾期工单、超温严重 */
.text-orange { color: #E6A23C; }   /* 高危告警、设备离线、即将逾期 */
.text-blue { color: #409EFF; }     /* 处理中的正常状态、主要操作按钮 */
.text-green { color: #67C23A; }    /* 已恢复正常、已闭环 */

.bg-red { background-color: #F56C6C; }
.bg-orange { background-color: #E6A23C; }
.bg-blue { background-color: #409EFF; }
.bg-green { background-color: #67C23A; }

/* 通用组件样式 */
.button-lg {
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 15rpx;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
