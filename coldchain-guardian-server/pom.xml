<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.coldchain</groupId>
    <artifactId>coldchain-guardian-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>coldchain-guardian-server</name>
    <description>Cold Chain Guardian Server - Multi-module Project</description>
    <packaging>pom</packaging>

    <modules>
        <module>ccg-app</module>
        <module>ccg-infrastructure</module>
        <module>ccg-contract</module>
        <module>ccg-common</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <mysql.version>8.0.33</mysql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.coldchain</groupId>
                <artifactId>ccg-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.coldchain</groupId>
                <artifactId>ccg-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.coldchain</groupId>
                <artifactId>ccg-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>